    [
        _CLIENT_SOURCE_ROOT + "Replicant.gwt.xml",
        _CLIENT_SOURCE_ROOT + "ReplicantDebug.gwt.xml",
        _CLIENT_SOURCE_ROOT + "ReplicantDev.gwt.xml",
    ],
    visibility = ["//tools/release:__pkg__"],
)

j2cl_library(
    name = "client-j2cl",
    srcs = CLIENT_JAVA_SRCS + [
        _CLIENT_SOURCE_ROOT + "ReplicantConfig.native.js",
        _CLIENT_SOURCE_ROOT + "replicant.js",
        "//tools/release:client_generated_sources",
    ],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    visibility = ["//visibility:public"],
    deps = [
        "//shared/src/main/java/replicant/shared:shared-j2cl",
        "//third_party/java:arez_core-j2cl",
        "//third_party/java:base-j2cl",
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:grim_annotations-j2cl",
        "//third_party/java:javax_annotation-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jspecify-j2cl",
        "//third_party/java:org_jetbrains_annotations-j2cl",
        "//third_party/java:zemeckis_core-j2cl",
    ],
)

java_library(
    name = "client_lib_impl",
    srcs = CLIENT_JAVA_SRCS,
    plugins = [
        "//third_party/java:arez_processor_plugin",
        "//third_party/java:grim_processor_plugin",
    ],
    resource_strip_prefix = "client/src/main/java",
    resources = CLIENT_RESOURCES,
    visibility = ["//tools/release:__pkg__"],
    deps = CLIENT_DEPS,
)

java_import(
    name = "client_lib",
    jars = [":libclient_lib_impl.jar"],
    srcjar = ":libclient_lib_impl-src.jar",
    visibility = ["//visibility:public"],
    deps = CLIENT_DEPS,
)

java_library(
    name = "client_test_support",
    visibility = [
        "//client/src/test/java/replicant:__pkg__",
        "//client/src/test/java/replicant:__subpackages__",
    ],
    exports = [
        ":client_lib",
        "//client/src/test/java/replicant:client_test_support_lib",
        "//client/src/test/java/replicant/messages:messages_test_support_lib",
        "//shared:shared_lib",
        "//third_party/java:arez_core",
        "//third_party/java:arez_extras_testng",
        "//third_party/java:braincheck_core",
        "//third_party/java:braincheck_testng",
        "//third_party/java:byte_buddy",
        "//third_party/java:javax_json",
        "//third_party/java:mockito_core",
        "//third_party/java:objenesis",
        "//third_party/java:testng",
    ],
)

java_single_jar(
    name = "client",
    visibility = ["//visibility:public"],
    deps = [":client_lib"],
)
